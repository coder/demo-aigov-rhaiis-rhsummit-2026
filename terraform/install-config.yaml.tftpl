apiVersion: v1
baseDomain: ${base_domain}
credentialsMode: Manual
metadata:
  name: ${cluster_name}
controlPlane:
  # Compact (3-node converged) cluster: control-plane nodes are also
  # schedulable for workloads (`compute.replicas: 0` below). Sized large
  # enough to absorb everything except RHAIIS, which lives on the GPU
  # MachineSet defined as a second compute pool. m6i.4xlarge gives ~13
  # vCPU per node usable for workloads after kube-control-plane + OS
  # overhead.
  hyperthreading: Enabled
  name: master
  replicas: ${control_plane_count}
  platform:
    aws:
      type: ${control_plane_instance_type}
      rootVolume:
        size: 120
        type: gp3
compute:
# Single "worker" pool — OpenShift IPI only supports "worker" or "edge" as
# compute pool names. In the converged-cluster pattern the 3 CP nodes carry
# all CPU workloads; this pool provides the GPU node(s) for RHAIIS.
# When gpu_count=0 the pool has 0 replicas (pure converged, no GPU).
# NVIDIA GPU Operator + NFD label these nodes nvidia.com/gpu.present=true;
# RHAIIS lands here via nodeSelector + resource request.
- hyperthreading: Enabled
  name: worker
  replicas: ${gpu_count}
%{ if gpu_count > 0 ~}
  platform:
    aws:
      type: ${gpu_instance_type}
      zones:
        - ${gpu_zone}
      rootVolume:
        size: 200
        type: gp3
%{ endif ~}
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  machineNetwork:
  - cidr: ${machine_cidr}
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16
platform:
  aws:
    region: ${aws_region}
    # BYO-VPC: list every subnet (public + private) the installer is allowed
    # to use. The installer auto-detects public vs private from the subnet's
    # route table (IGW route → public, NAT route → private). All subnets
    # must be tagged kubernetes.io/cluster/<name>: shared (handled by the
    # VPC module).
    subnets:
%{ for s in subnet_ids ~}
      - ${s}
%{ endfor ~}
publish: External
pullSecret: |
  ${pull_secret}
sshKey: |
  ${ssh_pubkey}
